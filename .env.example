# Copy this file to .env and add your own provider credentials.
# Never commit secrets or real .env files.

DEEPSEEK_API_KEY=
BAILIAN_API_KEY=
BAILIAN_WORKSPACE_ID=
# Optional: set this instead of deriving the endpoint from BAILIAN_WORKSPACE_ID.
# BAILIAN_API_HOST=

# Milvus vector database
MILVUS_ENDPOINT=http://127.0.0.1:19530
MILVUS_TOKEN=

# Allow the local Vite development server to call the API.
RAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local knowledge-base persistence
RAG_KB_RUNTIME_PATH=tmp/runtime_knowledge_base.jsonl
